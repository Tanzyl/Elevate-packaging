DATABASE_URL=postgresql://elevatepackaging:elevatepackaging_dev@localhost:5434/elevatepackaging?schema=public

# REQUIRED. The API refuses to start without a real secret (>=32 chars, and it
# may not contain "change-me"). Generate one per environment:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
SESSION_DAYS=7

# Session cookies are Secure by default. Set this to "true" ONLY for local
# HTTP development, never in a deployed environment.
COOKIE_INSECURE=true

# REQUIRED before running `prisma:seed` (>=12 chars). There is no default admin
# password — a committed one would be a published credential.
SEED_ADMIN_EMAIL=admin@elevatepackaging.com
SEED_ADMIN_PASSWORD=

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WHATSAPP_NUMBER=15550100100
# Google Tag Manager container ID (optional), e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# The admin panel is not served in production builds unless this is "true".
# The NestJS API it depends on is not deployed (see CLAUDE.md → Deployment), so
# shipping /admin publicly is attack surface with no function.
# ADMIN_ENABLED=false

# Public form handler endpoint (Formspree/Web3Forms/Basin) for contact + RFQ forms.
# Create a form at https://formspree.io and paste its endpoint here, e.g.
# NOTE: Next.js only reads apps/web/.env* — set NEXT_PUBLIC_* vars in apps/web/.env.local, not here.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx   (or https://formsubmit.co/ajax/<email>)
NEXT_PUBLIC_FORM_ENDPOINT=
