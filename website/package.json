{
  "name": "elevatepackaging",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "web": "pnpm --filter @elevatepackaging/web",
    "api": "pnpm --filter @elevatepackaging/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  }
}
